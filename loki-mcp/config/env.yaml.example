# 三个 MCP 可共用同一份 env.yaml；不要将真实文件提交到 Git。
env:
  - env_name: "示例 UAT"

    # db-mcp：db_connect_name 是调用 test_connection/query 等工具时使用的数据源别名。
    db_connect_name: "example_pg"
    db_type: "postgres" # postgres | mysql | oracle
    db_host: "db.example.internal"
    db_port: 5432
    db_name: "example_database" # Oracle 时填写 Service Name
    db_user: "readonly_user"
    db_passwd: "REPLACE_WITH_PASSWORD"
    schema: "public"

    # loki-mcp：不使用 Loki 时可删除下列字段。
    loki_url: "https://grafana.example.internal/grafana/"
    loki_datasource_uid: "loki_datasource_uid"
    loki_user_name: "readonly_user"
    loki_passwd: "REPLACE_WITH_PASSWORD"
    loki_query: '{namespace="example-namespace"}'

    # k8s-mcp：不使用 K8s 时可删除下列字段。
    k8s_ns: "example-namespace"
    k8s_kubeconfig: "cce-cloudpond-uat-mes-kubeconfig.yaml"
    # k8s_context: "uat-context"
