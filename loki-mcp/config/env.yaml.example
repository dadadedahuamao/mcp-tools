# DB/Loki/K8s/Redis MCP 可共用同一份 env.yaml；真实文件不要提交 Git。
env:
  - env_name: "示例 UAT"
    db: {connect_name: example_pg, type: postgres, host: db.example.internal, port: 5432, name: example_database, user: readonly_user, password: "", schema: public}
    loki: {url: https://grafana.example.internal/grafana/, datasource_uid: loki_datasource_uid, username: readonly_user, password: "", query: '{namespace="example-namespace"}'}
    k8s: {namespace: example-namespace, kubeconfig: cce-cloudpond-uat-mes-kubeconfig.yaml, context: uat-context}
    redis: {mode: standalone, host: redis.example.internal, port: 6379, database: 0, password: ""}
