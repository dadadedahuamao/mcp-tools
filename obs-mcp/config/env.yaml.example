env:
  - env_name: "UAT"
    obs:
      # S3/MinIO 兼容 endpoint；不得包含 AK/SK。
      endpoint: "http://uat-mes-obs.cloudpond.obs.cn-east-3.myhuaweicloud.com"
      access_key_id: "REPLACE_WITH_ACCESS_KEY"
      secret_access_key: "REPLACE_WITH_SECRET_KEY"
      region: "cn-east-3"
      buckets: ["mfg-mes", "mfg-mes-public"]
      connect_timeout_seconds: 5
      read_timeout_seconds: 15
